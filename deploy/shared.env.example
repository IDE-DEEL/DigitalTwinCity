# Copy this file to <DEPLOY_PATH>/shared/.env on the server and replace every
# placeholder before the first deployment.

# Public domain and TLS
DOMAIN=your-subdomain.duckdns.org
LETSENCRYPT_EMAIL=admin@example.com
DUCKDNS_DOMAIN=your-subdomain
DUCKDNS_TOKEN=change_me

# PostgreSQL
DT_PG_DB=dt_project
DT_PG_ADMIN_USER=admin
DT_PG_ADMIN_PASS=change_me_strong_database_password
DT_PG_DEVELOPER_USER=app_developer
DT_PG_DEVELOPER_PASS=change_me_strong_developer_database_password
DT_PG_MONITOR_USER=postgres_exporter
DT_PG_MONITOR_PASS=change_me_strong_monitor_database_password
DATABASE_URL=postgresql+psycopg://app_developer:change_me_strong_developer_database_password@postgres:5432/dt_project?sslmode=require

# Backend authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_strong_admin_password
SECRET_KEY=change_me_generate_a_long_random_secret

# Browser/API configuration
FRONTEND_API_URL=https://your-subdomain.duckdns.org
CORS_ALLOW_ORIGINS=https://your-subdomain.duckdns.org
SESSION_COOKIE_NAME=deel_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=your-subdomain.duckdns.org

# Backend MQTT client. This password must match the same user in mqtt-users.env.
MQTT_HOST=your-subdomain.duckdns.org
MQTT_PORT=443
MQTT_PATH=/mqtt
MQTT_USERNAME=backend_user
MQTT_PASSWORD=change_me_rotated_backend_mqtt_password

# Mosquitto broker users are generated from username=password lines in:
# <DEPLOY_PATH>/shared/mosquitto/mqtt-users.env

# Monitoring
GF_SERVER_ROOT_URL=https://your-subdomain.duckdns.org/grafana/
GRAFANA_PASSWORD=change_me_strong_grafana_password

# Alertmanager SMTP sender.
# File must contain only the SMTP/app password.
ALERTMANAGER_SMTP_AUTH_PASSWORD_FILE=/opt/digital-twin/shared/alertmanager/smtp_auth_password