.env for local development (copy this file to .env and fill in the values)

# ---- PostgreSQL ----
DT_PG_DB=dt_project
DT_PG_ADMIN_USER=admin
DT_PG_ADMIN_PASS=ChangeMe_Admin_StrongPassword

# ---- Backend ----
POSTGRES_DB=dt_project
POSTGRES_USER=admin
POSTGRES_PASSWORD=ChangeMe_Admin_StrongPassword
DATABASE_URL=postgresql+psycopg://admin:ChangeMe_Admin_StrongPassword@postgres:5432/dt_project?sslmode=require
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe_Admin_StrongPassword
SECRET_KEY=een_lange_random_string_voor_jwt_tokens
CORS_ALLOW_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost
SESSION_COOKIE_NAME=deel_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=
