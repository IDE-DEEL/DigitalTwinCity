# ---- Website / HTTPS ----
DOMAIN=<your-domain>
LETSENCRYPT_EMAIL=<your-email-address>

# ---- DuckDNS ----
DUCKDNS_DOMAIN=<your-duckdns-domain>
DUCKDNS_TOKEN=<your-duckdns-token>

# ---- MQTT for the browser (WebSockets) ----
VITE_MQTT_WS_URL=wss://<your-domain>/mqtt
VITE_MQTT_WS_TOPIC=car/auto_A/#
# MQTT broker users are generated from shared/mosquitto/mqtt-users.env on the server.

# ---- PostgreSQL ----
DT_PG_DB=dt_project
DT_PG_ADMIN_USER=admin
DT_PG_ADMIN_PASS=ChangeMe_Admin_StrongPassword
DT_PG_DEVELOPER_USER=app_developer
DT_PG_DEVELOPER_PASS=ChangeMe_Developer_Db_StrongPassword
DT_PG_MONITOR_USER=postgres_exporter
DT_PG_MONITOR_PASS=ChangeMe_Monitor_Db_StrongPassword

# ---- Grafana ----
GRAFANA_PASSWORD=ChangeMe_Grafana_StrongPassword
GF_SERVER_ROOT_URL=https://<your-domain>/grafana/

# ---- Backend ----
POSTGRES_DB=dt_project
POSTGRES_USER=app_developer
POSTGRES_PASSWORD=ChangeMe_Developer_Db_StrongPassword
DATABASE_URL=postgresql+psycopg://app_developer:ChangeMe_Developer_Db_StrongPassword@postgres:5432/dt_project?sslmode=require
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe_Admin_StrongPassword
SECRET_KEY=een_lange_random_string_voor_jwt_tokens
CORS_ALLOW_ORIGINS=https://<your-domain>,http://localhost:8080,http://localhost:5173,http://localhost
SESSION_COOKIE_NAME=deel_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=
