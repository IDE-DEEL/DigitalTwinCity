#.env for local development (copy this file to .env and fill in the values)
# ---- Backend ----
POSTGRES_DB=dt_project
POSTGRES_USER=admin
POSTGRES_PASSWORD=eenheelsterkwachtwoord
DATABASE_URL=postgresql+psycopg://admin:eenheelsterkwachtwoord@db:5432/dt_project
ADMIN_USERNAME=admin
ADMIN_PASSWORD=1234
SECRET_KEY=een_lange_random_string_voor_jwt_tokens
CORS_ALLOW_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost
SESSION_COOKIE_NAME=deel_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=

# ---- Backend MQTT client ----
MQTT_HOST=localhost
MQTT_PORT=443
MQTT_PATH=/mqtt
MQTT_USERNAME=backend_user
MQTT_PASSWORD=change_me_rotated_backend_mqtt_password